// Complete .claude/settings.json wiring for all three hooks.
// Merge the "hooks" block into your existing settings — back it up first.
// Paths assume you copied the scripts to ~/.claude/scripts/ (see docs/INSTALL.md).
{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Bash|Write|Edit",
        "hooks": [
          { "type": "command", "command": "$HOME/.claude/scripts/session-logger.sh", "timeout": 5 }
        ]
      },
      {
        "matcher": "Task",
        "hooks": [
          { "type": "command", "command": "$HOME/.claude/scripts/dw-monitor.sh", "timeout": 5 }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          { "type": "command", "command": "$HOME/.claude/scripts/session-distiller.sh", "timeout": 90 }
        ]
      }
    ]
  }
}
